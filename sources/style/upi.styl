.modal.upi
    .container
        width 380px
        max-width calc(100vw - 40px)

    .content
        text-align center

    .title
        margin-bottom 0.6em

    .qr
        display block
        width 220px
        height auto
        margin 1em auto
        border-radius 8px
        background-color #ffffff
        padding 8px

    .upi-id-row
        display flex
        align-items center
        justify-content center
        gap 8px
        margin 1em auto 0.6em
        flex-wrap wrap

        .label
            font-size 0.8em
            opacity 0.7
            text-transform uppercase
            letter-spacing 0.06em

        .upi-id
            font-family monospace
            font-size 0.95em
            background-color rgba(255, 255, 255, 0.08)
            padding 4px 8px
            border-radius 4px
            user-select all
